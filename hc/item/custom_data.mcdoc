use ::java::data::loot::LootTableRef


dispatch mcdoc:custom_data[hc:item/id] to Id
dispatch mcdoc:custom_data[hc:item/replace_with] to ReplaceItemLootTable
dispatch mcdoc:custom_data[hc:item/clear_instantly] to ClearInstantly
dispatch mcdoc:custom_data[hc:item/armor/apply_team_dye_color]
    to ApplyTeamDyeColor
dispatch mcdoc:custom_data[hc:item/armor/apply_team_trim_material]
    to ApplyTeamTrimMaterial


/// Custom item ID component.
type Id = #[match_regex="^[a-z0-9_]+(:[a-z0-9_/]+)?$"] string


/// This component works as a work-around for the `minecraft:use_remainder`
/// component limitations (can't apply item modifiers, or make an infinitely
/// consumable item). When this component is detected in an item, it is
/// replaced a tick after detection.
///
/// # TODO:
/// This replacement must be deferred or scheduled one tick after because
/// same tick replacement causes them to be BUGGED!. No animations, no cooldown
/// indicator... etc.
///
/// # FIXME:
/// if the aforementioned bug is ever fixed by Mojang, return to the old
/// system, or a simplier one.
struct ReplaceItemLootTable {
    loot_table?: LootTableRef,
}


/// Component for items that must be cleared instantly from the inventory.
struct ClearInstantly {}


/// Component for overriding the `minecraft:dyed_color` component with the
/// player's team color.
struct ApplyTeamDyeColor {}


/// Component for overriding the `"minecraft:trim".material` component with the
/// player's team color.
struct ApplyTeamTrimMaterial {}
