/// Struct for parameters of the `effect` command.
struct MobEffect {
    /// Effect resource name.
    effect: #[id="mob_effect"] string,

    /// Effect amplifier.
    amplifier: int @ 0..,

    /// Duration in seconds of the effect.
    ///
    /// `"infinite"` can be used to indicate infinite duration.
    seconds: (#[canonical] int @ 1.. | "infinite"),

    /// `true` if the particles of the effect are hidden.
    hide_particles: boolean,
}
