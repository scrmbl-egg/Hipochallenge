use ::java::util::attribute::AttributeOperation


/// Struct for parameters of the attribute modifier command.
struct Modifier {
    /// ID of the modifier.
    id: #[match_regex="^[a-z0-9_]+(:[a-z0-9_/]+)?$"] string,

    /// Attribute name.
    attribute: #[id="attribute"] string,

    /// Modifier operation.
    operation: AttributeOperation,

    /// Modifier value.
    value: double,
}


/// Struct for a modifier reference. Locating an attribute modifier requires the
/// `attribute` it modifies and its `id`.
struct ModifierRef {
    /// ID of the modifier.
    id: Modifier[id],

    /// Attribute name.
    attribute: Modifier[attribute],
}


/// Struct for temporary attribute modifiers.
struct TempModifier {
    /// Duration in ticks of the attribute modifier.
    duration_ticks: int @ 1..,

    ...Modifier,
}
