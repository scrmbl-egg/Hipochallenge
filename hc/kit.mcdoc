use ::java::util::text::TranslatedText
use ::java::data::loot::LootTableRef
use super::attribute::Modifier
use super::attribute::ModifierRef
use super::effect::MobEffect
use super::util::Table


dispatch hc:kit/data[hc:effect_table] to DataTable<[MobEffect], "effects">
dispatch hc:kit/data[hc:effect_ref_table]
    to DataTable<[MobEffect[effect]], "effects">
dispatch hc:kit/data[hc:modifier_table] to DataTable<[Modifier], "modifiers">
dispatch hc:kit/data[hc:modifier_ref_table]
    to DataTable<[ModifierRef], "modifiers">


/// Type alias for a table inside a kit's data map.
type DataTable<V, VFieldName> = Table<string, V, VFieldName>

/// Struct for class kits.
///
/// A kit is one of multiple pre-defined sets of items and special attributes
/// which the player can switch between rounds. A kit's definition contains the
/// loot tables that will be used to give items to the player, and the reusable
/// data those items will use to perform their operations.
struct Kit {
    /// ID of the kit, i.e. the value `hc.Kit` objective must match to select
    /// this kit.
    id: int @ 1..3,

    /// Translated text for the kit name.
    name: TranslatedText,

    /// Loot tables for kit equipment.
    item_loot_tables: struct ItemLootTables {
        /// Loot table that will be given across the player's hotbar.
        hotbar: LootTableRef,

        /// Loot table that will be given in the player's offhand slot.
        offhand: LootTableRef,
    },

    /// Map of reusable data components this kit uses.
    data?: struct DataMap {
        [#[dispatcher_key="hc:kit/data"] string]: hc:kit/data[[%key]],
    },
}
