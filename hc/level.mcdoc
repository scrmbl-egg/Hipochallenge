use ::java::util::text::TranslatedText
use super::game::GameModePresetBase


/// Level information struct.
struct Level {
    /// Numeric ID of the level.
    id: LevelId,

    /// Key the level.
    key: (
        #[canonical] LevelKey |
        #[match_regex="^(?!hc$|hc:)[a-z0-9_]+(:[a-z0-9_]+)?$"] string |
    ),

    /// Translated text for the level name.
    name: TranslatedText,
}


/// Enum for level numeric IDs.
enum(int) LevelId {
    /// Numeric ID for the Conduit level.
    Conduits = 0,

    /// Numeric ID for the Froggyland level.
    FroggyLand = 1,

    /// Numeric ID for the Sepulchral level.
    Sacrifice = 2,

    /// Numeric ID for the Villager Factory level.
    VillagerFactory = 3,

    /// Numeric ID for the Derailed level.
    Derailed = 4,
}


/// Enum for level keys. These are shortened names so they match
/// their `trigger lv_*` command names.
enum(string) LevelKey {
    /// Key for the Conduit level.
    Conduits = "hc:cnduit",

    /// Key for the Froggyland level.
    FroggyLand = "hc:froggy",

    /// Key for the Sepulchral level.
    Sacrifice = "hc:sacrif",

    /// Key for the Villager Factory level.
    VillagerFactory = "hc:fctory",

    /// Key for the Derailed level.
    Derailed = "hc:derail",
}
