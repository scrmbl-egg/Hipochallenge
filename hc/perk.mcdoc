use ::java::util::text::TranslatedText
use super::attribute::Modifier
use super::attribute::ModifierRef
use super::effect::MobEffect
use super::util::Table


dispatch hc:perk/data[hc:effect_table] to DataTable<[MobEffect], "effects">
dispatch hc:perk/data[hc:effect_ref_table]
    to DataTable<[MobEffect[effect]], "effects">
dispatch hc:perk/data[hc:modifier_table] to DataTable<[Modifier], "modifiers">
dispatch hc:perk/data[hc:modifier_ref_table]
    to DataTable<[ModifierRef], "modifiers">


/// Type alias for a table inside a perk's data map.
type DataTable<V, VFieldName> = Table<string, V, VFieldName>

/// Struct for class perks.
///
/// A perk is one of multiple
/// which the player can switch between each round. A kit's definition contains
/// the loot tables that will be used to give items to the player, and the
/// reusable data those items will use to perform their operations.
struct Perk {
    /// ID of the perk, i.e. the value `hc.Perk` objective must match to
    /// select this perk.
    id: int @ 1..3,

    /// Translated text for the perk name.
    name: TranslatedText,

    /// **(Nullable)**
    /// Function called when the player equips the perk. This can be used for
    /// setting up resources, scores... etc.
    ///
    /// ### Note
    /// This function is called regardless of if the player is in a match team
    /// or in training, so any special cases should be handled in the function
    /// itself.
    on_equip_function?: #[id="function"] string,

    /// **(Nullable)**
    /// Map of reusable data components this perk uses.
    data?: struct DataMap {
        [#[dispatcher_key="hc:perk/data"] string]: hc:perk/data[[%key]],
    },
}
