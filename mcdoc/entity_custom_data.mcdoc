dispatch mcdoc:custom_data[hc:entity/item/no_pickup] to ItemNoPickup
dispatch mcdoc:custom_data[hc:entity/training_npc] to TrainingNpc
dispatch mcdoc:custom_data[hc:entity/spirit] to TankSpirit
dispatch mcdoc:custom_data[hc:entity/flare_arrow] to FlareArrow

/// Component for items that will maximize the `PickupDelay` data parameter when dropped.
struct ItemNoPickup {}

/// Component for the NPCs available in training mode.
struct TrainingNpc {
    /// UUID of the entity that summoned the NPC.
    owner_uuid: #[uuid] int[] @ 4,
}

/// Component for Tank Kit 3 spirit.
struct TankSpirit {
    /// UUID of the owner of the spirit.
    owner_uuid: #[uuid] int[] @ 4,
    /// UUID of the target, to which the spirit will give its armor attribute modifier.
    target_uuid: #[uuid] int[] @ 4,
    /// UUID of the marker
    goal_uuid: #[uuid] int[] @ 4,
}

/// Component for Recon Kit 2 flare arrows.
struct FlareArrow {
    /// UUID of the player/entity that shot the flare arrow.
    owner_uuid: #[uuid] int[] @ 4,
    /// Team that is going to be detected by the flare arrow.
    detected_team: #[team] string,
    /// Parameters for the arrow's AABB casting.
    aabb_params: struct {
        /// Entities that are going to be detected by the AABB.
        entity_selector: #[entity] #[selector] string,
        /// Command that the detected entity will run when detected.
        on_detection_command: #[command(max_length=32500)] string,
        /// Size of the AABB.
        size: [double] @ 3,
    },
    /// Flare arrow explosion data.
    explosion: struct {
        /// Explosion radius.
        radius: double @ 0..,
        /// Entities that are going to be affected by the explosion.
        entity_selector: #[entity] #[selector] string,
    }
}
