dispatch mcdoc:custom_data[hc:item/id] to Id
dispatch mcdoc:custom_data[hc:item/replace_with] to ReplaceItemLootTable
dispatch mcdoc:custom_data[hc:item/clear_instantly] to ClearInstantly
dispatch mcdoc:custom_data[hc:item/no_pickup] to NoPickup

/// Custom item ID component.
type Id = #[match_regex="\\b[a-zA-Z_]\\w*\\b"] string

/// Component for `minecraft:use_remainder` items that must return to its original state.
type ReplaceItemLootTable = #[id="loot_table"] string

/// Component for items that must be cleared instantly from the inventory.
struct ClearInstantly {}

/// Component for items that will maximize the `PickupDelay` data parameter when dropped.
struct NoPickup {}
