use ::java::util::text::TextBase
use ::java::util::text::TranslatedText
use ::java::util::text::TextColor
use ::java::util::avatar::Profile

/// Struct for representing a team.
struct TeamPreset {
    /// Internal name of the team.
    internal_name: TeamPresetName,
    /// ID of the team preset.
    id: TeamPresetId,
    /// Translated text of the team's default name.
    default_name: TranslatedText,
    /// Color of the team's name in team's prefix.
    name_color?: (#[color="hex_rgb"] string | #[color="named"] TextColor),
    /// Vanilla color of the team.
    text_color?: TextColor,
    /// RGB of the dust particles for the team.
    dust_color: #[color="dec_rgb"] [float] @ 3,
    /// Team's leather armor color.
    armor_dye_color: (
		#[canonical] #[color="composite_rgb"] int |
		#[color="dec_rgb"] [float] @ 3 |
	),
    /// Team's custom armor trim material.
    trim_material: #[id="trim_material"] string,
}

struct TeamContext {
    /// **(Nullable)** Custom name of the team.
    custom_name?: struct TeamNameText {
        ...TextBase,
        text: string @ 1..16
    },
    /// Team preset.
    preset: TeamPreset,
    /// List of player profiles in the team.
    player_profiles: [Profile] @ 0..3,
}

/// All possible team color names.
enum(string) TeamPresetName {
    /// Neutral team color name (gray).
    Neutral = "neutral",
    /// Red team color name.
    Red = "red",
    /// Yellow team color name.
    Yellow = "yellow",
    /// Green team color name.
    Green = "green",
    /// Blue team color name.
    Blue = "blue",
    /// Purple team color name.
    Purple = "purple",
    /// Orange team color name.
    Orange = "orange",
    /// Cyan team color name.
    Cyan = "cyan",
}

/// Team color ID's, used for datapack predicates.
enum(int) TeamPresetId {
    /// Neutral team color ID.
    Neutral = 0,
    /// Red team color ID.
    Red = 1,
    /// Yellow team color ID.
    Yellow = 2,
    /// Green team color ID.
    Green = 3,
    /// Blue team color ID.
    Blue = 4,
    /// Purple team color ID.
    Purple = 5,
    /// Orange team color ID.
    Orange = 6,
    /// Cyan team color ID.
    Cyan = 7,
}
