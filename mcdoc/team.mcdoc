use ::java::util::text::TextColor

/// Struct for representing a team.
struct Team {
    /// Color of the team's name in team's prefix.
    name_color: (#[color="hex_rgb"] string | #[color="named"] TextColor),
    /// Vanilla color of the team.
    text_color: TextColor,
    /// Number that corresponds to the team's color (used for predicates).
    color_id: TeamColorId,
    /// RGB of the dust particles for the team.
    dust_color: #[color="dec_rgb"] [float] @ 3,
    /// Team's leather armor color.
    armor_color: #[color="composite_rgb"] int,
    /// Team's custom armor trim material.
    trim_material: (
        #[id(registry="trim_material",tags="allowed")] string |
        [#[id="trim_material"] string]
    ),
}

struct TeamContext {
    ...Team,
    /// (Nullable) Custom name of the team.
    custom_name?: string @ 1..10,
}

/// All possible team color NBT fields in the datapack constants.
/// Used for accessing data through macros.
enum(string) TeamColorNBTField {
    /// Neutral team color name (gray).
    Neutral = "neutral",
    /// Red team color name.
    Red = "red",
    /// Yellow team color name.
    Yellow = "yellow",
    /// Green team color name.
    Green = "green",
    /// Blue team color name.
    Blue = "blue",
    /// Purple team color name.
    Purple = "purple"
}

/// Team color ID's, used for datapack predicates.
enum(int) TeamColorId {
    /// Neutral team color ID.
    Neutral = 0,
    /// Red team color ID.
    Red = 1,
    /// Yellow team color ID.
    Yellow = 2,
    /// Green team color ID.
    Green = 3,
    /// Blue team color ID.
    Blue = 4,
    /// Purple team color ID.
    Purple = 5
}

/// Struct of available teams to choose from.
struct AvailableTeams {
    /// Neutral/training team.
    neutral: Team,
    /// Red team.
    red: Team,
    /// Yellow team.
    yellow: Team,
    /// Green team.
    green: Team,
    /// Blue team.
    blue: Team,
    /// Purple team.
    purple: Team
}
