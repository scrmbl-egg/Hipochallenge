use ::java::util::text::TranslatedText
use ::Hipochallenge::mcdoc::effect::AbilityEffects
use ::Hipochallenge::mcdoc::attribute::AttributeModifierCommmandParameters as AttributeModifier
use ::Hipochallenge::mcdoc::player_selection::PlayerSelectionInfo

/// Base struct for kits.
struct KitBase {
    /// ID of the kit.
    id: int @ 1..3,
    /// Translated text for the kit name.
    name: TranslatedText,
    /// Loot tables for kit equipment.
    item_loot_tables: struct KitItemLootTables {
        /// Loot table that will be given across the player's hotbar.
        hotbar: (#[id="loot_table"] string | ::java::data::loot::LootTable),
        /// Loot table that will be given in the player's offhand slot.
        offhand: (#[id="loot_table"] string | ::java::data::loot::LootTable),
    },
    /// Type of data this kit holds. This is used to identify the union variant of the kit data.
    data_type: string,
}

/// Union type that encapsulates all kit types.
type Kit = (
    // First tank kit.
    struct TankKit1 {
        ...KitBase,
        id: 1,
        data_type: "tank_k1_data",
        /// Tank's kit 1 variant data.
        tank_k1_data: struct {
            /// Goat horn related data.
            horn: struct {
                /// Radius of the effects.
                radius: double @ 0..,
                /// Effects that will be given to allies.
                effects_info: AbilityEffects
            },
        }
    } |
    // Second tank kit.
    struct TankKit2 {
        ...KitBase,
        id: 2,
        data_type: "tank_k2_data",
        /// Tank's kit 2 variant data.
        tank_k2_data: struct {
            /// Goat horn related data.
            horn: struct {
                /// Radius of the effects.
                radius: double @ 0..,
                /// Effects that will be given to enemies.
                effects_info: AbilityEffects,
                /// Amount of ticks that define the time frame the owner can recover their ability if the enemies are out of range.
                recovery_ticks: int @ 0..
            },
            /// Trident related data.
            trident: struct {
                /// Cooldown after landing.
                cooldown_ticks: int @ 0.. // TODO: cooldown should obtained from item's "consumable" data component
            }
        }
    } |
    struct TankKit3 {
        ...KitBase,
        id: 3,
        data_type: "tank_k3_data",
        /// Tank's kit 3 variant data.
        tank_k3_data: struct {
            /// Goat horn related data.
            horn: struct {
                /// Radius of the attributes.
                radius: double @ 0..,
                /// Modifiers that will be applied to the enemies in the radius.
                modifiers: [AttributeModifier],
            },
            /// Spirit related data.
            spirit: struct {
                /// Player selection related data.
                selection: PlayerSelectionInfo,
                /// Buff related data.
                buff: struct {
                    /// Radius in which the spirit gives its buff.
                    radius: double @ 0..,
                    /// Modifiers that are applied to the target.
                    modifiers: [AttributeModifier]
                },
                /// Data related to the de-buff that is given to the owner when targetting the spirit to other player.
                owner_debuff: struct {
                    /// Modifiers that are applied to the owner.
                    modifiers: [AttributeModifier]
                }
            },
            /// Bubble shield related data.
            bubble_shield: struct {
                /// Command that is executed on a random part of the bubble's surface for drawing.
                draw_command: #[command(max_length=32500)] string,
                /// Radius of the bubble sphere.
                radius: double @ 0..,
                /// Radius for detecting high-speed arrows.
                /// Used for guaranteeing that no fast arrows pass through the bubble.
                high_speed_arrow_detection_radius: double @ 0..,
                /// Duration in ticks of the bubble's lifetime.
                lifetime_ticks: int @ 0..,
                /// Amount of ticks added to the bubble's lifetime when it successfully blocks a projectile.
                lifetime_ticks_added_on_impact: int @ 0..,
            }
        }
    } |
    struct MarksmanKit1 {
        ...KitBase,
        id: 1,
        data_type: "marksman_k1_data",
        /// Marksman's kit 1 variant data.
        marksman_k1_data: struct {
            /// Arrow related data.
            arrows: struct {
                /// Maximum amount of arrows the owner can have.
                max_amount: int @ 1..,
                /// Cooldown of the first arrow given after shooting the last one.
                new_first_cooldown_ticks: int @ 0..,
                /// Cooldown of the rest of arrows right after the first new arrow is given.
                new_rest_cooldown_ticks: int @ 0..
            }
        }
    } |
    struct MarksmanKit2 {
        ...KitBase,
        id: 2,
        data_type: "marksman_k2_data",
        /// Marksman's kit 2 variant data.
        marksman_k2_data: struct {
            /// Arrow related data.
            arrows: struct {
                /// Maximum amount of arrows the owner can have.
                max_amount: int @ 1..,
                /// Cooldown of the first arrow given after shooting the last one.
                new_first_cooldown_ticks: int @ 0..,
                /// Cooldown of the rest of arrows right after the first new arrow is given.
                new_rest_cooldown_ticks: int @ 0..
            }
        }
    } |
    struct MarksmanKit3 {
        ...KitBase,
        id: 3,
        data_type: "marksman_k3_data",
        /// Marksman's kit 3 variant data.
        marksman_k3_data: struct {
            /// Regular bullet related data.
            bullets: struct {
                /// Maximum amount of bullets the owner can have.
                max_amount: int @ 1..,
                /// Cooldown of the first bullet given after shooting the last one.
                new_first_cooldown_ticks: int @ 0..,
                /// Cooldown of the rest of bullets right after the first new bullet is given.
                new_rest_cooldown_ticks: int @ 0..
            },
            /// Revolver related data.
            revolver: struct {
                /// Maximum amount of bullets that can be loaded into the gun.
                max_loaded_bullet_amount: int @ 1..,
                /// Cooldown ticks the next shot is going to take.
                per_shot_cooldown_ticks: int @ 1.., // TODO: this should probably be moved to a consumable data component
                /// Pitch rotation when the revolver is shot.
                recoil_pitch_rotation: double @ -90.0..90.0
            }
        }
    } |
    struct AssassinKit1 {
        ...KitBase,
        id: 1,
        data_type: "assassin_k1_data",
        /// Assassin's kit 1 variant data.
        assassin_k1_data: struct {
            /// Parry related information.
            parry: struct {
                /// Modifiers applied to the owner when the parry fails.
                on_owner_when_fail: struct {
                    modifiers: [AttributeModifier]
                },
                /// Modifiers applied to the owner when the parry succeeds.
                on_owner_when_success: struct {
                    modifiers: [AttributeModifier]
                },
                /// Modifiers and effects applied to the enemy when they are parried.
                on_enemy_when_parried: struct {
                    /// Effects that are going to be applied.
                    effects_info: AbilityEffects,
                    /// Modifiers that are going to be applied.
                    modifiers: [AttributeModifier]
                }
            }
        }
    } |
    struct AssassinKit2 {
        ...KitBase,
        id: 2,
        data_type: "assassin_k2_data",
        /// Assassin's kit 2 variant data.
        assassin_k2_data: struct {
            stun_mechanism: struct {
                radius: double @ 0..,
                effects_info: AbilityEffects,
            }
        }
    } |
    struct AssassinKit3 {
        ...KitBase,
        id: 3,
        data_type: "assassin_k3_data",
        /// Assassin's kit 3 variant data.
        assassin_k3_data: struct {}
    } |
    struct SupportKit1 {
        ...KitBase,
        id: 1,
        data_type: "support_k1_data",
        /// Support's kit 1 variant data.
        support_k1_data: struct {}
    } |
    struct SupportKit2 {
        ...KitBase,
        id: 2,
        data_type: "support_k2_data",
        /// Support's kit 2 variant data.
        support_k2_data: struct {}
    } |
    struct SupportKit3 {
        ...KitBase,
        id: 3,
        data_type: "support_k3_data",
        /// Support's kit 3 variant data.
        support_k3_data: struct {}
    } |
    struct ReconKit1 {
        ...KitBase,
        id: 1,
        data_type: "recon_k1_data",
        /// Recon's kit 1 variant data.
        recon_k1_data: struct {}
    } |
    struct ReconKit2 {
        ...KitBase,
        id: 2,
        data_type: "recon_k2_data",
        /// Recon's kit 2 variant data.
        recon_k2_data: struct {
            /// Data for flare arrows.
            flare_arrow: struct {
                /// Maximum amount of flare arrows the player can hold at a time.
                max_amount: int @ 1..,
                /// Amount of ticks it will take to get another flare arrow.
                cooldown_ticks: int @ 2..,
                /// Size of the AABB's that detect enemy players.
                detection_aabb_size: [double @ 0..] @ 3,
                /// Explosion related data.
                explosion: struct {
                    /// Radius of the explosion.
                    radius: double @ 0..,
                    /// Effects that will be given to the detected enemies.
                    effects_info: AbilityEffects
                }
            }
        }
    } |
    struct ReconKit3 {
        ...KitBase,
        id: 3,
        data_type: "recon_k3_data",
        /// Recon's kit 3 variant data.
        recon_k3_data: struct {}
    } |
    struct AssaultKit1 {
        ...KitBase,
        id: 1,
        data_type: "assault_k1_data",
        /// Assault's kit 1 variant data.
        assault_k1_data: struct {}
    } |
    struct AssaultKit2 {
        ...KitBase,
        id: 2,
        data_type: "assault_k2_data",
        /// Assault's kit 2 variant data.
        assault_k2_data: struct {}
    } |
    struct AssaultKit3 {
        ...KitBase,
        id: 3,
        data_type: "assault_k3_data",
        /// Assault's kit 3 variant data.
        assault_k3_data: struct {}
    } |
)
