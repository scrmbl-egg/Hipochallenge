use ::java::util::text::TranslatedText
use ::Hipochallenge::mcdoc::effect::EffectCommandParameters as Effect
use ::Hipochallenge::mcdoc::attribute::AttributeModifierCommmandParameters
    as AttributeModifier

/// Base struct for kits.
struct KitBase {
    /// ID of the kit.
    id: int @ 1..3,
    /// Translated text for the kit name.
    name: TranslatedText,
    /// Command for equipping the kit.
    equip_command: #[command(max_length=32500)] string,
}

/// Union type that encapsulates all kit types.
type Kit = (
    // First tank kit.
    struct TankKit1 {
        ...KitBase,
        id: 1,
        data_type: "tank_k1_data",
        /// Tank's kit 1 variant data.
        tank_k1_data: struct {
            /// Goat horn related data.
            horn: struct {
                /// Radius of the effects.
                radius: double @ 0..,
                /// List of effects that will be given to allies.
                effects: [Effect]
            },
            /// Castling ability related data.
            castling: struct {
                /// Cooldown ticks after using the
                cooldown_ticks: int @ 0..
            }
        }
    } |
    // Second tank kit.
    struct TankKit2 {
        ...KitBase,
        id: 2,
        data_type: "tank_k2_data",
        /// Tank's kit 2 variant data.
        tank_k2_data: struct {
            /// Goat horn related data.
            horn: struct {
                /// Radius of the effects.
                radius: double @ 0..,
                /// List of effects that will be given to enemies.
                effects: [Effect],
                /// Amount of ticks that define the time frame the owner can recover their ability if the enemies are out of range.
                recovery_ticks: int @ 0..
            },
            /// Trident related data.
            trident: struct {
                /// Cooldown
                cooldown_ticks: int @ 0.. // TODO: cooldown should obtained from item's "consumable" data component
            }
        }
    } |
    struct TankKit3 {
        ...KitBase,
        id: 3,
        data_type: "tank_k3_data",
        tank_k3_data: struct {
            horn: struct {
                radius: double @ 0..,
                modifiers: [AttributeModifier],
            },
            spirit: struct {
                selection: struct {
                    forward_distance: double @ 0..,
                    sphere_radius: double @ 0..
                },
                buff: struct {
                    radius: double @ 0..,
                    modifiers: [AttributeModifier]
                },
                owner_debuff: struct {
                    modifiers: [AttributeModifier]
                }
            },
            bubble_shield: struct {
                draw_command: #[command(max_length=32500)] string,
                radius: double @ 0..,
                high_speed_arrow_detection_radius: double @ 0..,
                lifetime_ticks: int @ 0..,
                lifetime_ticks_added_on_impact: int @ 0..,
            }
        }
    } |
    struct MarksmanKit1 {
        ...KitBase,
        id: 1,
        data_type: "marksman_k1_data",
        marksman_k1_data: struct {
            projectiles: struct {
                max_amount: int @ 1..,
                new_first_cooldown_ticks: int @ 0..,
                new_rest_cooldown_ticks: int @ 0..
            }
        }
    } |
    struct MarksmanKit2 {
        ...KitBase,
        id: 2,
        data_type: "marksman_k2_data",
        marksman_k2_data: struct {
            projectiles: struct {
                max_amount: int @ 1..,
                new_first_cooldown_ticks: int @ 0..,
                new_rest_cooldown_ticks: int @ 0..
            }
        }
    } |
    struct MarksmanKit3 {
        ...KitBase,
        id: 3,
        data_type: "marksman_k3_data",
        marksman_k3_data: struct {
            projectiles: struct {
                max_amount: int @ 1..,
                new_first_cooldown_ticks: int @ 0..,
                new_rest_cooldown_ticks: int @ 0..
            },
            revolver: struct {
                max_loaded_projectile_amount: int @ 1..,
                per_shot_cooldown_ticks: int @ 1..,
                recoil_pitch_rotation: double @ -180..180
            }
        }
    } |
    struct AssassinKit1 {
        ...KitBase,
        id: 1,
        data_type: "assassin_k1_data",
        assassin_k1_data: struct {
            parry: struct {
                on_owner_when_fail: struct {
                    modifiers: [AttributeModifier]
                },
                on_owner_when_success: struct {
                    modifiers: [AttributeModifier]
                },
                on_enemy_when_parried: struct {
                    effects: [Effect],
                    modifiers: [AttributeModifier]
                }
            }
        }
    } |
    struct AssassinKit2 {
        ...KitBase,
        id: 2,
        data_type: "assassin_k2_data",
        assassin_k2_data: struct {}
    } |
    struct AssassinKit3 {
        ...KitBase,
        id: 3,
        data_type: "assassin_k3_data",
        assassin_k3_data: struct {}
    } |
    struct SupportKit1 {
        ...KitBase,
        id: 1,
        data_type: "support_k1_data",
        support_k1_data: struct {}
    } |
    struct SupportKit2 {
        ...KitBase,
        id: 2,
        data_type: "support_k2_data",
        support_k2_data: struct {}
    } |
    struct SupportKit3 {
        ...KitBase,
        id: 3,
        data_type: "support_k3_data",
        support_k3_data: struct {}
    } |
    struct ReconKit1 {
        ...KitBase,
        id: 1,
        data_type: "recon_k1_data",
        recon_k1_data: struct {}
    } |
    struct ReconKit2 {
        ...KitBase,
        id: 2,
        data_type: "recon_k2_data",
        recon_k2_data: struct {}
    } |
    struct ReconKit3 {
        ...KitBase,
        id: 3,
        data_type: "recon_k3_data",
        recon_k3_data: struct {}
    } |
    struct AssaultKit1 {
        ...KitBase,
        id: 1,
        data_type: "assault_k1_data",
        assault_k1_data: struct {}
    } |
    struct AssaultKit2 {
        ...KitBase,
        id: 2,
        data_type: "assault_k2_data",
        assault_k2_data: struct {}
    } |
    struct AssaultKit3 {
        ...KitBase,
        id: 3,
        data_type: "assault_k3_data",
        assault_k3_data: struct {}
    } |
)
