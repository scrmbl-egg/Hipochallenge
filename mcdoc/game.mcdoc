use ::java::util::text::TranslatedText
use super::level::LevelId

/// Game context/global variables struct.
struct GameContext {
    /// Current game mode data.
    mode: struct GameModeContext {
        /// Current state of the game mode.
        state: GameModeState,
        /// Game mode preset.
        preset: GameModePreset,
    },
    /// Amount of players playing the game, doesn't count spectators.
    users_playing: int @ 0..,
    /// Current round number.
    round: int @ 1..,
    /// ID of the current level being played.
    level_id: LevelId,
    /// Amount of points/rounds won by Team 1.
    team1_wins: int @ 0..,
    /// Amount of points/rounds won by Team 2.
    team2_wins: int @ 0..,
    /// List of banned level IDs.
    banned_level_ids: [LevelId],
}

/// Game mode struct.
struct GameModePresetBase {
    /// Internal name of the game mode preset.
    internal_name: #[match_regex="^[a-z0-9_]+(:[a-z0-9_]+)?$"] string,
    /// Internal numeric ID of the game mode.
    id: (#[canonical] GameModeId | int @ ..-1 | int @ 3..),
    /// Translated text for the game mode name.
    name: TranslatedText,
    /// Size of the two teams in this game mode.
    team_size: int @ 1..6,
    /// All possible states.
    states: [GameModeState],
}

struct GameModeState {
    /// Internal name of the game mode preset.
    internal_name: string,
    /// Numeric ID of the state.
    ///
    /// `0` is not allowed, since returning it in the specified `tick_function`
    /// means ending the match.
    id: (int @ ..-1 | int @ 1..),
    /// Function that is run before the state is processed every tick.
    enter_function: #[id="function"] string,
    /// Function that is run every tick for processing the game mode's state.
    ///
    /// This function must return an `int` that represents the next state.
    /// `0` is reserved for indicating the match has to end (and thus, stopping
    /// the game state machine).
    ///
    /// Example:
    /// ```mcfunction
    /// # go to state with ID of 1
    /// execute if predicate custom:example_predicate run return 1
    ///
    /// # stop the match
    /// execute unless predicate custom:example_predicate run return 0
    /// ```
    tick_function: #[id="function"] string,
    /// Function that is run just before the next state starts.
    exit_function: #[id="function"] string,
}

/// Game mode ID enum.
enum(int) GameModeId {
    /// Casual game mode.
    Casual = 0,
    /// Competitive game mode.
    Competitive = 1,
    /// Deathmatch game mode.
    DeathMatch = 2,
}

type GameModePreset = (
    GameModePresetBase |
    struct CasualGameMode {
        ...GameModePresetBase,
        internal_name: "hc:casual",
        id:0,
        /// Casual game mode data.
        casual_data: struct {
            ...struct RoundBasedData {
                /// Amount of rounds a team must win to win the whole match.
                rounds_to_win: int @ 1..,
                /// Duration of a round in seconds.
                round_duration_seconds: int @ 1..,
                /// Duration of the kit and perk selection intermission.
                intermission_duration_seconds: int @ 1..,
            },
        }
    } |
    struct CompetitiveGameMode {
        ...GameModePresetBase,
        internal_name: "hc:competitive",
        id:1,
        /// Competitive game mode data.
        competitive_data: struct {
            ...RoundBasedData,
            /// Won round lead to win the match.
            min_winning_lead: int @ 0..,
        }
    } |
    struct DeathMatchGameMode {
        ...GameModePresetBase,
        internal_name: "hc:deathmatch",
        id:2,
        /// Deathmatch game mode data.
        deathmatch_data: struct {
            /// Amount of kills a team must do to win the match prematurely.
            kills_to_win: int @ 1..,
            /// Duration of the match in seconds.
            duration_seconds: int @ 1..,
        }
    }
)
