use ::java::util::text::TranslatedText
use ::Hipochallenge::mcdoc::level::LevelId

/// Game context/global variables struct.
struct GameContext {
    /// Current game state.
    current_state: GameState,
    /// Current game mode structure.
    current_game_mode: GameMode,
    /// Amount of players playing the game, doesn't count spectators.
    users_playing: int @ 0..,
    /// Current round number.
    current_round: int @ 1..,
    /// ID of the current level being played.
    current_level_id: LevelId,
    /// Amount of points/rounds won by Team 1.
    team1_wins: int @ 0..,
    /// Amount of points/rounds won by Team 2.
    team2_wins: int @ 0..,
    /// List of banned level IDs.
    banned_level_ids: [LevelId]
}

/// Game mode struct.
struct GameMode {
    /// Internal name of the game mode.
    internal_name: GameModeName,
    /// Internal numeric ID of the game mode.
    id: GameModeId,
    /// Translated text for the game mode name.
    name: TranslatedText,
    /// Duration of a game round in ticks.
    round_duration_ticks: #[divisible_by=20] int @ 20..,
    /// Amount of rounds/points that must be won by default to win a game.
    necessary_wins: int @ 1..,
    /// Size of the two teams in this game mode.
    team_size: int @ 1..6,
    /// Minimum amount of rounds/points that the winning team must lead with to win the game.
    minimum_win_lead_for_victory: int @ 1..,
}

/// Game states of the game.
enum(string) GameState {
    /// State where the players are not playing.
    NotPlaying = "not_playing",
    /// State where a match is requested and is waiting for players.
    WaitingForPlayers = "waiting_for_players",
    /// State where all players have joined and are selecting their team.
    SelectingTeam = "selecting_team",
    /// State where the teams are decided, and a random player of the team decides the name.
    NamingTeam = "naming_team",
    /// State where the players decide on a color for the team.
    SelectingTeamColor = "selecting_team_color",
    /// State where the players select their class for the game.
    SelectingClasses = "selecting_classes",
    /// State where the players select/ban/decide on a level for the game.
    SelectingLevel = "selecting_level",
    /// State where the players are shown the level they are going to play.
    LevelIntro = "level_intro",
    /// State where the players select the kit for the next round.
    SelectingKit = "selecting_kit",
    /// State where the players wait for the round to start.
    StartingRound = "starting_round",
    /// State where the players are playing the round.
    PlayingRound = "playing_round",
    /// State where the players have finished the round.
    EndingRound = "ending_round",
    /// State where the players have finished the match and a winner is announced.
    EndingMatch = "ending_match"
}

enum(string) GameModeName {
    Casual = "casual",
    Competitive = "competitive",
    Deathmatch = "deathmatch"
}

enum(int) GameModeId {
    Casual = 0,
    Competitive = 1,
    DeathMatch = 2
}

