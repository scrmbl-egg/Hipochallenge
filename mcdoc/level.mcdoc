use ::java::util::text::TranslatedText

type LocalSpaceVolumeCoordinates = [[int[] @ 3] @ 2]

/// Level information struct.
struct Level {
    /// Internal ID of the level.
    id: LevelId,
    /// Internal name of the level.
    internal_name: #[match_regex="^[A-Za-z0-9_]+$"] string,
    /// Translated text for the level name.
    name: TranslatedText,
    /// List of callouts.
    callouts: [Callout],
    /// Event callbacks of the level.
    event_callbacks: struct LevelEventCallbacks {
        /// Command ran when the match starts.
        match_start_command: #[id="function"] string,
        /// Command ran when the round starts.
        round_start_command: #[id="function"] string,
        /// Command ran when the round timer ends.
        overtime_command: #[id="function"] string,
        /// Command ran when the round ends.
        round_end_command: #[id="function"] string,
        /// Command ran when the match ends.
        match_end_command: #[id="function"] string,
        /// Command ran each tick.
        tick_command: #[id="function"] string,
        /// Command ran every ten ticks.
        ten_ticks_command: #[id="function"] string,
        /// Command ran every second.
        second_command: #[id="function"] string,
    },
}

/// Callout information struct.
struct Callout {
    /// Translated text for the callout name.
    name: TranslatedText,
    /// List of volumes of the callout.
    local_space_volume_coordinates: LocalSpaceVolumeCoordinates,
}

enum(int) LevelId {
    PracticeArea = 0,
    SubterraneanDecay = 1,
    FroggylandPlayplace2 = 2,
    SepulchredSacrifice2 = 3,
    VillagerFactory = 4,
    CrazyTrains = 5,
}
