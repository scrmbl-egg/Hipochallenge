use ::java::util::text::TranslatedText
use super::game::GameModePresetBase


type LocalSpaceVolumeCoordinates = [[int[] @ 3] @ 2]


/// Level information struct.
struct Level {
    /// Numeric ID of the level.
    id: LevelId,

    /// Internal name of the level.
    internal_name: (
        #[canonical] LevelInternalName |
        #[match_regex="^(?!hc$|hc:)[a-z0-9_]+(:[a-z0-9_]+)?$"] string |
    ),

    /// Translated text for the level name.
    name: TranslatedText,
}


/// Enum for level numeric IDs.
enum(int) LevelId {
    /// Numeric ID for the Subterranean Decay level.
    SubterraneanDecay = 1,

    /// Numeric ID for the Froggyland Playplace 2 level.
    FroggylandPlayplace2 = 2,

    /// Numeric ID for the Sepulchred Sacrifice 2 level.
    SepulchredSacrifice2 = 3,

    /// Numeric ID for the Villager Factory level.
    VillagerFactory = 4,

    /// Numeric ID for the Villager Factory level.
    CrazyTrains = 5,
}


/// Enum for level internal names. These are shortened names so they match
/// their `trigger lv_*` commands.
enum(string) LevelInternalName {
    /// Internal name for the Subterranean Decay level.
    SubterraneanDecay = "hc:subdec",

    /// Internal name for the Froggyland Playplace 2 level.
    FroggylandPlayplace2 = "hc:froggy",

    /// Internal name for the Sepulchred Sacrifice 2 level.
    SepulchredSacrifice2 = "hc:sacrif",

    /// Internal name for the Villager Factory level.
    VillagerFactory = "hc:vilfac",

    /// Internal name for the Crazy Trains level.
    CrazyTrains = "hc:ctrain",
}
