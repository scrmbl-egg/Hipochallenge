type LocalSpaceVolumeCoordinates = [[int[] @ 3] @ 2]

/// Level information struct.
struct Level {
    /// Internal ID of the level.
    id: LevelId,
    /// Resource pack lang file JSON key for the level name.
    name_translation_key: string,
    /// Level name fallback.
    name_fallback: string,
    /// List of callouts.
    callouts: [Callout]
}

/// Callout information struct.
struct Callout {
    /// Resource pack lang file JSON key for the callout name.
    name_translation_key: string,
    /// Callout name fallback.
    name_fallback: string,
    /// List of volumes of the callout.
    local_space_volume_coordinates: LocalSpaceVolumeCoordinates
}

enum(byte) LevelId {
    TrainingArea = 0,
    SubterraneanDecay = 1,
    FroggylandPlayplace2 = 2,
    SepulchredSacrifice2 = 3,
}
