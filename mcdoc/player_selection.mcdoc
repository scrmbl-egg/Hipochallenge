/// Struct for data related to selecting a player.
struct PlayerSelectionInfo {
    /// Target mode, which specifies which players will be selected.
    target_mode: PlayerSelectionTargetMode,
    /// Maximum amount of distance the target can be from the executing player
    /// to be selected.
    max_distance: float @ 0..,
    /// Command that the selected player will execute.
    on_selected_command: #[command(max_length=32500)] string,
}

/// Enum representing the modes available for targetting players.
enum(string) PlayerSelectionTargetMode {
    /// Targets all players.
    TargetAll = "all",
    /// Targets only allies.
    TargetAlliesOnly = "allies_only",
    /// Targets only enemies.
    TargetEnemiesOnly = "enemies_only",
}
