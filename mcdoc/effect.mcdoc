/// Struct for parameters of the effect command.
struct EffectCommandParameters {
    /// Effect name.
    effect: #[id="mob_effect"] string,

    /// Effect amplifier.
    amplifier: int @ 0..,

    /// Duration in seconds of the effect.
    ///
    /// `"infinite"` can be used to indicate infinite duration.
    seconds: (#[canonical] int @ 0.. | "infinite"),

    /// `true` if the particles of the effect are hidden.
    hide_particles: ("true" | "false"),
}


/// Struct for effect information inside game abilities.
struct AbilityEffects {
    /// Amount of ticks the targets will be suppressed for.
    suppression_ticks: int @ 0..,

    /// List of effects the ability will give.
    effects: [EffectCommandParameters],
}
