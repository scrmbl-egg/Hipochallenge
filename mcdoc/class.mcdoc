/// Enum of all class names.
enum(string) ClassName {
    /// Tank class name.
    Tank = "tank",
    /// Marksman class name.
    Marksman = "marksman",
    /// Assassin class name.
    Assassin = "assassin",
    /// Support class name.
    Support = "support",
    /// Recon class name.
    Recon = "recon",
    /// Assault class name.
    Assault = "assault"
}

/// Enum of all class ID's.
enum(byte) ClassId {
    /// Tank class ID.
    Tank = 1,
    /// Marksman class ID.
    Marksman = 2,
    /// Assassin class ID.
    Assassin = 3,
    /// Support class ID.
    Support = 4,
    /// Recon class ID.
    Recon = 5,
    /// Assault class ID.
    Assault = 6
}

/// All classes struct.
struct AvailableClasses {
    /// Tank class related constants.
    tank: TankClass,
    /// Marksman class related constants.
    marksman: MarksmanClass,
    /// Assassin class related constants.
    assassin: AssassinClass,
    /// Support class related constants.
    support: SupportClass,
    /// Recon class related constants.
    recon: ReconClass,
    /// Assault class related constants.
    assault: AssaultClass
}
