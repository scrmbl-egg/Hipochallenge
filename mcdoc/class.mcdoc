    perk1: ::Hipochallenge::mcdoc::perk::AssassinPerk1,
    /// Perk 2.
    perk2: ::Hipochallenge::mcdoc::perk::AssassinPerk2,
    /// Perk 3.
    perk3: ::Hipochallenge::mcdoc::perk::AssassinPerk3
}

