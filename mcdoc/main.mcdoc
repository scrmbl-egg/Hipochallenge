use ::Hipochallenge::mcdoc::team::TeamPreset
use ::Hipochallenge::mcdoc::team::TeamContext
use ::Hipochallenge::mcdoc::class::Class
use ::Hipochallenge::mcdoc::game::GameMode
use ::Hipochallenge::mcdoc::game::GameContext
use ::Hipochallenge::mcdoc::level::Level

dispatch minecraft:storage[hc:main] to MainStorage

struct MainStorage {
    /// Global constants of the datapack.
    consts: struct MainConsts {
        /// Version of the map.
        map_version: string,
        /// Game related constants.
        game: struct GameConstants {
            /// Size of a team.
            team_size: int @ 1..,
            /// Players necessary for starting a game.
            necessary_players_for_game: int @ 1..,
            /// Duration of the match request notification.
            match_request_duration_ticks: int @ 1..,
            /// Available game modes.
            modes: [GameMode],
        },
        limits: struct Limits {
            no_gravity_projectiles_lifetime_ticks: int @ 0..
        },
        /// List of available classes, with their constants.
        classes: [Class],
        /// Amount of classes.
        class_count: int @ 0..,
        /// List of available team presets.
        team_presets: [TeamPreset],
        /// Amount of team presets.
        team_preset_count: int @ 0..,
    },
    /// Global variables of the datapack.
    vars: struct MainVars {
        /// Amount of times the datapack has been reloaded.
        reload_count: int @ 0..,
        /// Current game context/global variables.
        game_context: GameContext,
        /// Team global variables.
        team_contexts: struct TeamContexts {
            /// Team 1 global variables.
            team1: TeamContext,
            /// Team 2 global variables.
            team2: TeamContext
        }
    }
}
