#>core_hc:music/mute_vanilla
#
# Mutes all possible minecraft tracks in the music channel at every tick.
# This allows for custom tracks to play in the channel, while not allowing the
# game to play its tracks through random chance.

stopsound @a music minecraft:music.game
stopsound @a music minecraft:music.creative
stopsound @a music minecraft:music.menu
stopsound @a music minecraft:music.dragon
stopsound @a music minecraft:music.credits
stopsound @a music minecraft:music.end
stopsound @a music minecraft:music.nether.basalt_deltas
stopsound @a music minecraft:music.nether.crimson_forest
stopsound @a music minecraft:music.nether.nether_wastes
stopsound @a music minecraft:music.nether.soul_sand_valley
stopsound @a music minecraft:music.nether.warped_forest
stopsound @a music minecraft:music.overworld.desert
stopsound @a music minecraft:music.overworld.badlands
stopsound @a music minecraft:music.overworld.forest
stopsound @a music minecraft:music.overworld.jungle
stopsound @a music minecraft:music.overworld.deep_dark
stopsound @a music minecraft:music.overworld.swamp
stopsound @a music minecraft:music.overworld.cherry_grove
stopsound @a music minecraft:music.overworld.bamboo_jungle
stopsound @a music minecraft:music.overworld.dripstone_caves
stopsound @a music minecraft:music.overworld.flower_forest
